{
  "version": 2,
  "description": "Ratuber Behavior Registry. This file describes the behaviors available to the AI. The AI should select behaviors by semantic meaning rather than directly controlling Live2D parameters.",
  "rules": {
    "selection": "Choose behaviors according to the semantic meaning of the conversation.",
    "preferred_level": "CombinationBehavior should normally be preferred for emotional or conversational responses.",
    "atom_usage": "AtomBehavior can be used when a simple single motion or expression is sufficient.",
    "levels": [
      "compose",
      "preset",
      "atom"
    ],
    "level_note": "compose: randomly pick a motion and an expression from emotion_pools (expression must be in the motion's compatible_expressions). preset: use the CombinationBehavior with the same id as the emotion. atom: send only a single expression (or motion). Fall back in this order when time is tight or composition fails.",
    "compose_rules": [
      "Only pair a motion with an expression listed in that motion's compatible_expressions.",
      "If an emotion pool has no motions, send the expression only.",
      "Avoid picking the same result twice in a row for the same emotion when other choices exist."
    ],
    "automatic_systems": [
      "BlinkManager",
      "MouthOpenManager",
      "Breath",
      "NaturalHeadMovement",
      "NaturalBodyMovement"
    ],
    "automatic_system_note": "Automatic systems do not need to be explicitly selected by the AI."
  },

